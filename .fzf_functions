# FZF Functions
# https://github.com/junegunn/fzf/wiki/examples

# Canonical list of working directories for fzf functions
FZF_WORK_DIRS=(
  "${DROP}/Active_Directories/Publications"
  "${DROP}/Active_Directories/Personal"
  "$INBOX"
  "$LANG"
  "$REF"
  "$NOTES"
  "$TEACH"
  "$PROF"
  "$ADMIN"
  "$PROJ"
)


# Help
alias fzh='echo "$FZHELP"'
FZHELP=' fd: recursive change directory\n fdw: change to working directory\n fo: open file\n fow: open file from working directory\n fmd: read file inline in MarkDown\n fa: recursively open file in atom\n fmw: move file recursively to working directory\n fmr: move file recursively within directory\n fmk: move file to common Kitob Khona directory\n fzc: search within file content recursively\n ftf: create and open new file in working directory\n fh: command line history\n fsl: create symlink to file or folder\n fsll: create symlink into current directory\n fcp: copy path of file or directory to clipboard'

alias gith='echo "$GITHELP"'
GITHELP=' gac "msg": git add all and commit\n fgit: git add all, commit with failsafe message, and push\n gadd <file>: git add specific file, commit, and push\n gfzf: pick modified/untracked file(s) in current repo via fzf, commit, and push\n gfz: pick modified/untracked file(s) across all repos under $PROJ via fzf, commit, and push'


# Fuzzy Change Directory (only within directories situated recursively below current context)
fd() {
  local dir
  dir=$(find . -type d | fzf) &&
  cd "$dir" && ls -a
}

# Fuzzy Change Directory (from common working directory)
fdw() {
  local dir
  dir=$(find "${FZF_WORK_DIRS[@]}" -type d | fzf) &&
  cd "$dir" && ls -a
}


# Fuzzy Open File (only files nested recursively within current context)
fo() {
  local file
  file=$(find . -type f | fzf --preview 'cat {}' --delimiter / --with-nth -1) &&
  open "$file"
}

# Fuzzy Open File (from common working directory)
fow() {
  local file
  file=$(find "${FZF_WORK_DIRS[@]}" -type f | fzf --preview 'cat {}' --delimiter / --with-nth -1) &&
  open "$file"
}


# Fuzzy Open File in Atom (only files nested recursively within current context)
fa() {
  local file
  file=$(find . -type f | fzf --preview 'cat {}') &&
  a "$file"
}


# Fuzzy render MarkDown file in Glow (.md and .txt files from working dirs)
fmd() {
  local file
  file=$(find "${FZF_WORK_DIRS[@]}" -type f \( -name "*.md" -o -name "*.txt" \) | fzf --preview 'cat {}') &&
  cat "$file" | glow -p -
}


# Fuzzy Move File to Common Working Directories
fmw() {
  local file
  file=$(find . -type f | fzf -m --preview 'cat {}') &&
  local dir
  dir=$(find "${FZF_WORK_DIRS[@]}" -type d | fzf)
  echo "$file" | gxargs -n 1 -d "\n" -I "{}" mv "{}" "$dir"
}

# Fuzzy Move File to Common Kitob Khona directories
fmk() {
  local file
  file=$(find . -type f | fzf --preview 'cat {}') &&
  local dir
  dir=$(find "${KITOB}/Secondary_Works/Pickett Library" "${KITOB}/Secondary_Works/Unsorted Secondary Literature" "${KITOB}/Primary_Sources" -type d | fzf)
  mv "$file" "$dir"
}


# Fuzzy Move File (recursively within directory)
fmr() {
  local file
  file=$(find . -type f | fzf -m --preview 'cat {}') &&
  local dir
  dir=$(find . -type d | fzf)
  echo "$file" | gxargs -n 1 -d "\n" -I "{}" mv "{}" "$dir"
}


# Fuzzy search file contents (current folder)
## bug: currently this only works if there are no spaces in the filename
fzc() {
  local line
  local file
  line=$(ag . * | fzf --preview 'echo {} | cut -d : -f 1 | xargs cat' --delimiter / --with-nth -1)
  file=$(echo $line | cut -d : -f 1)
  open "$file"
}


f() {
    sels=( "${(@f)$(fd "${fd_default[@]}" "${@:2}"| fzf)}" )
    test -n "$sels" && print -z -- "$1 ${sels[@]:q:q}"
}


# Fuzzy Create File (in working folder)
ftf() {
  read "file?File name: "
  local dir
  dir=$(find "${FZF_WORK_DIRS[@]}" -type d | fzf)
  touch "${dir}/${file}"
  open "${dir}/${file}"
}


# Fuzzy Create Symlink (pick source from working dirs, pick destination dir)
fsl() {
  local src
  src=$(find "${FZF_WORK_DIRS[@]}" \( -type f -o -type d \) | \
    fzf --prompt="Symlink source: " --preview 'ls -la {}') || return
  local dest_dir
  dest_dir=$(find "${FZF_WORK_DIRS[@]}" -type d | \
    fzf --prompt="Symlink destination dir: ") || return
  ln -s "$src" "${dest_dir}/$(basename "$src")" &&
  echo "✓ Symlink created: ${dest_dir}/$(basename "$src") → $src"
}

# Fuzzy Create Symlink into current directory (faster, single selection)
fsll() {
  local src
  src=$(find "${FZF_WORK_DIRS[@]}" \( -type f -o -type d \) | \
    fzf --prompt="Symlink source: " --preview 'ls -la {}') || return
  ln -s "$src" "$(basename "$src")" &&
  echo "✓ Symlink: ./$(basename "$src") → $src"
}


# Fuzzy copy path of file or directory to clipboard
fcp() {
  local target
  target=$(find "${FZF_WORK_DIRS[@]}" \( -type f -o -type d \) | \
    fzf --prompt="Copy path: " --preview 'ls -la {}') || return
  echo -n "$target" | pbcopy
  echo "✓ Copied to clipboard: $target"
}


# fh - repeat history
fh() {
  print -z $( ([ -n "$ZSH_NAME" ] && fc -l 1 || history) | fzf +s --tac | sed -E 's/ *[0-9]*\*? *//' | sed -E 's/\\/\\\\/g')
}


# Git add specific file, commit with message, and push
gadd() {
  git add "$1"
  read "msg?Commit message: "
  git commit -m "$msg" && git push
}

# Git add file(s) via fzf picker (modified + untracked files in current repo), commit, and push
gfzf() {
  local files
  files=$( (git diff --name-only --diff-filter=M HEAD; git ls-files --others --exclude-standard) | \
    fzf -m --preview 'git diff HEAD -- {} 2>/dev/null || cat {}') || return
  echo "$files" | xargs git add
  read "msg?Commit message: "
  git commit -m "$msg" && git push
}

# Git add file(s) via fzf picker (modified + untracked files across all repos under $PROJ), commit, and push
gfz() {
  local files
  files=$(find "$PROJ" -maxdepth 2 -name ".git" -type d | while IFS= read -r gitdir; do
    local repo="${gitdir%/.git}"
    git -C "$repo" diff --name-only --diff-filter=M HEAD 2>/dev/null | sed "s|^|${repo}/|"
    git -C "$repo" ls-files --others --exclude-standard 2>/dev/null | sed "s|^|${repo}/|"
  done | fzf -m --preview 'git diff HEAD -- {} 2>/dev/null || cat {}') || return

  # Add files, grouped by repo
  echo "$files" | while IFS= read -r file; do
    local repo=$(git -C "$(dirname "$file")" rev-parse --show-toplevel 2>/dev/null)
    git -C "$repo" add "$file"
  done

  read "msg?Commit message: "

  # Commit and push each affected repo separately
  echo "$files" | while IFS= read -r file; do
    git -C "$(dirname "$file")" rev-parse --show-toplevel 2>/dev/null
  done | sort -u | while IFS= read -r repo; do
    echo "→ committing in $repo"
    git -C "$repo" commit -m "$msg" && git -C "$repo" push
  done
}